---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import ArticleLead from "../../components/ArticleLead.astro";
import ArticleRow from "../../components/ArticleRow.astro";
import { loadQuery } from "../../sanity/lib/load-query";

const { data: blogPosts } = await loadQuery<any[]>({
  query: `*[_type == "post"] | order(publishedAt desc) {
    title,
    slug,
    publishedAt,
    excerpt,
    mainImage,
    "readTime": round(length(pt::text(body)) / 5 / 200),
    categories[]->{ title }
  }`,
});

const lead = blogPosts?.[0];
const sideRows = blogPosts?.slice(1, 5) ?? [];
const moreRows = blogPosts?.slice(5) ?? [];
---

<Layout title="Blog" description="Articles from Ghana IP Pulse on copyright, trademarks, collective management and other intellectual property issues affecting Ghana.">
  <Navigation />
  <main class="flex-1 pt-16">
    <div class="bg-cream">
      <section class="py-8 lg:py-12">
        <div class="max-w-6xl mx-auto px-6 lg:px-8">
          <header class="mb-6 lg:mb-8 pb-4 border-b-2 border-forest-green">
            <h1 class="font-heading text-h2 font-bold text-forest-green">Articles</h1>
            <p class="text-sm text-muted-text mt-1">Practical intellectual property insights for Ghana's creators, businesses and students.</p>
          </header>

          {lead && (
            <div class="grid lg:grid-cols-[1.15fr_1fr] gap-8 lg:gap-12">
              <ArticleLead post={lead} />
              <div class="lg:-mt-4">
                {sideRows.map((post: any) => <ArticleRow post={post} />)}
              </div>
            </div>
          )}

          {moreRows.length > 0 && (
            <div class="mt-10 lg:mt-14">
              <h2 class="eyebrow text-forest-green pb-2 border-b-2 border-forest-green">More articles</h2>
              <div class="grid lg:grid-cols-2 lg:gap-x-12">
                {moreRows.map((post: any) => <ArticleRow post={post} />)}
              </div>
            </div>
          )}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
