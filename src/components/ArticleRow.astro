---
import ImageWithFallback from "./ImageWithFallback.astro";
import { getImageUrl, displayTitle, postMeta } from "../sanity/lib/post-utils";

const { post } = Astro.props;
const href = `/blog/${post.slug.current}`;
---

<a href={href} class="group flex items-start justify-between gap-4 py-4 border-b border-rule-border">
  <div class="min-w-0 flex-1">
    <div class="eyebrow text-warm-gold mb-1.5">{post.categories?.[0]?.title || "Article"}</div>
    <h3 class="font-heading text-base lg:text-[1.0625rem] font-semibold leading-snug tracking-tight text-forest-green line-clamp-2 group-hover:text-warm-gold transition-colors">
      {displayTitle(post.title)}
    </h3>
    {post.excerpt && (
      <p class="text-sm text-muted-text leading-relaxed mt-1.5 line-clamp-2 hidden sm:block">{post.excerpt}</p>
    )}
    <div class="text-xs text-muted-text mt-2">{postMeta(post)}</div>
  </div>
  <div class="w-[88px] h-[66px] sm:w-28 sm:h-[84px] lg:w-36 lg:h-24 flex-shrink-0 overflow-hidden rounded-lg" transition:name={`post-image-${post.slug.current}`}>
    <ImageWithFallback
      src={getImageUrl(post.mainImage, 400)}
      alt={post.title}
      class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
    />
  </div>
</a>
